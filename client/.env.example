# Leave as /api to use the dev proxy (vite.config.js) and the Vercel rewrite (vercel.json).
# Only set a full URL if you deliberately call the API cross-origin
# (then also set COOKIE_SAMESITE=none on the server).
VITE_API_URL=/api

# Firebase web config (Project settings > General > Your apps). These are public
# identifiers, not secrets; access is controlled by storage.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project-id>
VITE_FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app
VITE_FIREBASE_APP_ID=
