# ---- Runtime ----
NODE_ENV=development
PORT=5000

# ---- Database (MongoDB Atlas connection string, or local replica set) ----
# Later modules use multi-document transactions, which need a replica set.
# Atlas clusters are replica sets by default.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tally_business?retryWrites=true&w=majority

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d
# 'lax' when the client proxies /api via its own domain (recommended, see README).
# 'none' only if the browser calls the API on a different domain.
COOKIE_SAMESITE=lax

# ---- CORS ----
CLIENT_URL=http://localhost:5173
# Optional comma-separated extra origins (e.g. Vercel preview URLs)
CORS_ORIGINS=

# ---- Email (optional in development: links are printed to the console) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Tally Business <no-reply@yourdomain.com>

# ---- Firebase Admin (service account; NEVER put these in the client) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n line breaks, wrapped in double quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app
